# ============================================================
#  Copy this file to ".env" and fill in ONE provider's details.
#  Leave OPENAI_API_KEY blank to run FREE OFFLINE MOCK MODE.
# ============================================================

# ---- Option 1: Google Gemini (FREE, recommended) ----
# Get a key at https://aistudio.google.com/app/apikey
# OPENAI_API_KEY=your-gemini-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-flash-lite-latest

# ---- Option 2: OpenAI (paid, needs billing credits) ----
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# ---- Option 3: Groq (FREE, fast) ----
# Get a key at https://console.groq.com/keys
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# ---- Option 4: Ollama (FREE, runs locally, no key) ----
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2

# ---- Active settings (what the app actually reads) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
